{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HistoryEntry",
  "type": "object",
  "required": ["id", "title", "timestamp", "messages"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "timestamp": { "type": "number" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant"] },
          "content": { "type": "string" }
        }
      }
    }
  }
}
